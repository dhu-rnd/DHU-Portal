{
  "name": "@dhu-portal/frontend",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest --run --coverage",
    "test": "pnpm test:unit",
    "check:biome": "biome check --write",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:types": "tsc --noEmit",
    "check": "pnpm check:biome && pnpm check:types && pnpm check:svelte"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@sveltejs/adapter-cloudflare": "^7.2.6",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@tsconfig/strictest": "^2.0.8",
    "@tsconfig/svelte": "^5.0.8",
    "@vitest/coverage-v8": "4.0.18",
    "svelte": "^5.51.0",
    "svelte-check": "^4.4.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
