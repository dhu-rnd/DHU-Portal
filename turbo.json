{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": [ "^build" ],
			"outputs": [ ".svelte-kit/**", "dist/**" ]
		},
		"preview": {
			"dependsOn": [ "build" ],
			"cache": false,
			"persistent": true
		},
		"test": {
			"outputs": [ "coverage/**" ]
		},
		"check": {
			"cache": true
		}
	}
}
